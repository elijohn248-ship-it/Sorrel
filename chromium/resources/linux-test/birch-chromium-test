#!/bin/sh
set -eu
# Interactive UI testing only. Never use the normal Chromium-edition profile.
unset BIRCH_TEST BIRCH_DELAY BIRCH_HOLD BIRCH_PERSIST BIRCH_OPEN BIRCH_LOG
unset BIRCH_DOWNLOADS BIRCH_NETLOG BIRCH_HOSTMAP BIRCH_FAKE_MEDIA BIRCH_CEF_LOG
unset BIRCH_CHANNEL_EXTENSION BIRCH_HTTP_PORT BIRCH_HTTPS_PORT BIRCH_NONCE
unset BIRCH_EXPECT_ROWS BIRCH_EXPECT_SUFFIX
test_data="${XDG_DATA_HOME:-$HOME/.local/share}/birch-chromium-test"
mkdir -p "$test_data"
export BIRCH_HOME="$test_data" BIRCH_SHOW=1
exec /opt/birch-chromium-test/birch "$@"
